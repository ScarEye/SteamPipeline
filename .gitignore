# =========================
# Unity (github/gitignore)
# =========================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Uncomment if using Gradle
# /[Aa]ssets/Plugins/Android/gradle.properties
# /[Aa]ssets/Plugins/Android/local.properties

*.pidb.meta
*.pdb.meta
*.mdb.meta

sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
*.exe~
crashlytics-buildids.txt

# Autogenerated VS / Rider / VS Code
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
.idea/
*.rsuser

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================
# SteamPipeline / ContentBuilder
# =========================
# Staged game content and SteamPipe cache (legacy sdk/ + ignored SteamworksSDK~)
/sdk/tools/ContentBuilder/content/**
!/sdk/tools/ContentBuilder/content/.gitkeep
/sdk/tools/ContentBuilder/output/**
!/sdk/tools/ContentBuilder/output/.gitkeep
/SteamworksSDK~/tools/ContentBuilder/content/**
!/SteamworksSDK~/tools/ContentBuilder/content/.gitkeep
/SteamworksSDK~/tools/ContentBuilder/output/**
!/SteamworksSDK~/tools/ContentBuilder/output/.gitkeep

# Generated upload scripts (templates live under Editor/Templates)
/sdk/tools/ContentBuilder/scripts/*_generated.vdf
/sdk/tools/ContentBuilder/scripts/app_build_generated.vdf
/sdk/tools/ContentBuilder/scripts/depot_build_generated.vdf
/SteamworksSDK~/tools/ContentBuilder/scripts/*_generated.vdf
/SteamworksSDK~/tools/ContentBuilder/scripts/app_build_generated.vdf
/SteamworksSDK~/tools/ContentBuilder/scripts/depot_build_generated.vdf

# SteamCMD runtime logs (local, regenerated on every run)
**/ContentBuilder/builder/logs/
**/ContentBuilder/builder/logs.meta

# Steam login / Steam Guard session (never commit)
**/config.vdf
**/ssfn*
**/*.sentry
**/loginusers.vdf
**/SteamPipelineCredentials.*
**/steam_credentials.*

# Local build drops from this tool
/[Bb]uilds/
/BuildOutput/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
